# Reconstructs, from 100% public sources, the manylinux_2_34 (EL9 / glibc 2.34)
# CUDA/cuDNN/TensorRT base image that `build.py --target-platform=rhel` expects but does
# not install itself -- so you can reproduce a RHEL/manylinux Triton build without an
# internal, unpublished base image.
#
# Since 26.08, build.py's rhel path is manylinux-native: it assumes pypa's layout
# (/opt/_internal/cpython-*, the static libpython archive, and the pipx "shared" venv it
# puts first on PATH and uses as pip3/python3) and installs its own build tooling into that
# venv. So we start FROM the pypa image and add only what build.py assumes is already there.
#
# EXAMPLE ONLY -- not officially supported; equivalent, not identical, to the base
# NVIDIA uses for the released manylinux artifacts. See this tutorial's README.

# pypa's manylinux_2_34: AlmaLinux 9 (glibc 2.34), CPython builds under /opt/_internal.
# Pin a dated tag for reproducibility.
ARG BASE_IMAGE=quay.io/pypa/manylinux_2_34_x86_64:2026.09.05-1
FROM ${BASE_IMAGE}

# EPEL + CRB: part of build.py's own `yum install` list (re2-devel, libb64-devel,
# gperftools-devel) lives in EPEL and it assumes the repos are enabled.
RUN set -eux; \
    dnf install -y dnf-plugins-core epel-release; \
    dnf config-manager --set-enabled crb; \
    dnf clean all

# CUDA toolkit (same package set as nvidia/cuda:*-devel), cuDNN and TensorRT from the public
# cuda-rhel9 repo. TENSORRT_VERSION is the rpm's version-release; TensorRT trails CUDA by a
# minor, so a CUDA 13.4 toolkit pairs with a TensorRT built for cuda13.3. cuDNN is installed
# at exactly CUDNN_VERSION, and that value is exported below because ONNX Runtime's build only
# sets cudnn_home=/usr when the variable is set.
ARG CUDA_VERSION=13.4.1
ARG CUDNN_VERSION=9.25.1.1
ARG TENSORRT_VERSION=11.2.1.2-1.cuda13.3
RUN set -eux; \
    pkg=$(echo "${CUDA_VERSION}" | awk -F. '{print $1"-"$2}'); \
    dnf config-manager --add-repo \
        https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo; \
    dnf install -y \
        cuda-minimal-build-${pkg} cuda-libraries-devel-${pkg} cuda-command-line-tools-${pkg} \
        cuda-nvml-devel-${pkg} cuda-nvtx-${pkg} \
        libcudnn9-devel-cuda-13-${CUDNN_VERSION} \
        "tensorrt-devel-${TENSORRT_VERSION}"; \
    dnf clean all

# The environment nvidia/cuda images export (the Triton wheel build reads CUDA_VERSION).
ENV CUDA_VERSION=${CUDA_VERSION} \
    CUDNN_VERSION=${CUDNN_VERSION} \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}} \
    LIBRARY_PATH=/usr/local/cuda/lib64/stubs \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# gcc-toolset-13: the compiler NVIDIA's 26.08 manylinux artifacts are built with. EL9's
# rapidjson-devel (1.1.0), which build.py installs, does not compile with GCC 14.
RUN dnf install -y gcc-toolset-13-gcc-c++ gcc-toolset-13-libatomic-devel && dnf clean all
ENV PATH=/opt/rh/gcc-toolset-13/root/usr/bin:${PATH}

# build.py puts /opt/_internal/pipx/shared/bin first on PATH and uses its pip3/python3 for
# everything: its tooling, the Triton wheels, the python backend's runtime interpreter. In
# the stock pypa image that venv belongs to the newest CPython; Triton's RHEL
# build is Python 3.12 (the pytorch backend hardcodes cpython-3.12.x), so recreate it from cp312.
RUN set -eux; \
    rm -rf /opt/_internal/pipx/shared; \
    /opt/python/cp312-cp312/bin/python -m venv /opt/_internal/pipx/shared; \
    /opt/_internal/pipx/shared/bin/pip install --no-cache-dir --upgrade pip
ENV PATH=/opt/_internal/pipx/shared/bin:${PATH}

# Empty libpython for README Step 3's Python_LIBRARY: the core links libpython into its Python
# bindings, which don't need it, and pypa's static libpython can't go into a shared library.
RUN mkdir -p /opt/_internal/nolibpython && ar rcs /opt/_internal/nolibpython/libpython3.12.a

# Fail loudly if a bad pin left a piece missing or the wrong Python on PATH.
RUN set -eux; nvcc --version >/dev/null; g++ --version | head -1 | grep ' 13\.'; \
    rpm -q tensorrt-devel libcudnn9-devel-cuda-13; \
    python3 --version | grep -q ' 3\.12\.'; pip3 --version; \
    test -f /opt/_internal/static-libs-for-embedding-only.tar.xz
