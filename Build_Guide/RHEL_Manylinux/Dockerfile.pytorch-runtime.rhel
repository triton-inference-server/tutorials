# Completes the `tritonserver` image from Step 3 so the PyTorch backend can SERVE, not just
# build. ONLY needed for the pytorch backend; the other backends serve from the Step 3 image
# as-is.
#
# Two gaps build.py leaves for a prebuilt libtorch: the backend's Python stub does
# `import torch` at model load, and libtorch links NCCL and cuSPARSELt, which neither the
# base image nor build.py (it adds only nvshmem) installs. torch goes into the Python 3.12
# venv build.py wired up as `python3`; the two libraries come from the cuda-rhel9 repo the
# base image configured.

FROM tritonserver

# Match the libtorch the backend extracted from the Step 2 image.
# Keep this in sync with Dockerfile.pytorch.rhel's TORCH_VERSION -- a mismatch would ABI-break.
ARG TORCH_VERSION=2.14.0
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu132

RUN dnf install -y libnccl libcusparselt0-cuda-13 && dnf clean all
RUN python3 -m pip install --no-cache-dir "torch==${TORCH_VERSION}" --index-url "${TORCH_INDEX_URL}"
